# Copy to .env.development for local use, and set the same values in Netlify for production.
RESEND_API_KEY=re_xxxxxxxxx

# Optional. onboarding@resend.dev can only deliver to the email on your Resend account.
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=dukstack4@gmail.com

# Optional bot check from Cloudflare Turnstile. Set both keys, or neither.
GATSBY_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
